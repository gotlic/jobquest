<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
  <!-- Outer ring -->
  <circle cx="16" cy="16" r="14" fill="none" stroke="#7c3aed" stroke-width="2.5"/>
  <!-- Middle ring -->
  <circle cx="16" cy="16" r="9" fill="none" stroke="#7c3aed" stroke-width="2"/>
  <!-- Bullseye -->
  <circle cx="16" cy="16" r="4" fill="#7c3aed"/>
  <!-- Arrow shaft -->
  <line x1="24" y1="8" x2="17.2" y2="14.8" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round"/>
  <!-- Arrow head -->
  <polygon points="26,5 21,7 24,11" fill="#f59e0b"/>
</svg>
